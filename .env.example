# Tokn local configuration.
# Copy to .env and fill in. Never commit real values. No secret belongs in git.

# --- Shared ---
TOKN_ENV=development
TOKN_BASE_URL=http://localhost:8080
TOKN_CONSOLE_URL=http://localhost:8081
TOKN_SUPPORT_EMAIL=support@tokn.ng

# --- Database (PostgreSQL is the source of truth, including money) ---
TOKN_DATABASE_URL=postgresql+asyncpg://tokn:CHANGE_ME@localhost:5432/tokn
TOKN_DATABASE_POOL_SIZE=5

# --- Redis (cache and rate limits only; never money) ---
TOKN_REDIS_URL=redis://localhost:6379/0

# --- Secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" ---
TOKN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
TOKN_KEY_PEPPER=CHANGE_ME_LONG_RANDOM_STRING
TOKN_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# --- API key presentation (prefix is configurable per product/environment) ---
TOKN_KEY_PREFIX=tokn

# --- Upstream providers. Platform-owned accounts only. ---
TOKN_ANTHROPIC_API_KEY=
TOKN_OPENAI_API_KEY=
TOKN_GEMINI_API_KEY=
TOKN_DEEPSEEK_API_KEY=

# --- Payments ---
TOKN_PAYSTACK_SECRET_KEY=
TOKN_PAYSTACK_PUBLIC_KEY=

# --- Email ---
TOKN_RESEND_API_KEY=
TOKN_EMAIL_FROM=receipts@tokn.ng
